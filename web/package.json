{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001 -H 0.0.0.0",
    "dev:ws": "node ws-server/server.js",
    "dev:pm2": "pm2 start ecosystem.config.cjs",
    "dev:pm2:stop": "pm2 stop nextjs ws-server",
    "dev:pm2:restart": "pm2 restart ecosystem.config.cjs",
    "build": "prisma generate && next build",
    "start": "next start -p 3001 -H 0.0.0.0",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "node scripts/reset-db.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "chess.js": "^1.4.0",
    "jose": "^6.1.3",
    "next": "16.1.6",
    "pg": "^8.18.0",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-chessboard": "^5.8.6",
    "react-dom": "19.2.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "pm2": "^5.4.0",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
