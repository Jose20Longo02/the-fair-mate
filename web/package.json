{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001 -H 0.0.0.0",
    "dev:ws": "node ws-server/server.cjs",
    "dev:pm2": "pm2 start ecosystem.config.cjs",
    "dev:pm2:stop": "pm2 stop nextjs ws-server",
    "dev:pm2:restart": "pm2 restart ecosystem.config.cjs",
    "start:pm2": "pm2 start ecosystem.production.config.cjs",
    "start:pm2:stop": "pm2 stop ecosystem.production.config.cjs",
    "start:pm2:restart": "pm2 restart ecosystem.production.config.cjs",
    "build": "prisma generate && next build",
    "start": "next start -p 3001 -H 0.0.0.0",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "node scripts/reset-db.mjs",
    "compile": "hardhat compile",
    "deploy:deposit": "node scripts/deploy-deposit.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^6.19.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "bcryptjs": "^3.0.3",
    "chess.js": "^1.4.0",
    "ethers": "^6.16.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.1.3",
    "next": "16.1.6",
    "pg": "^8.18.0",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-chessboard": "^5.8.6",
    "react-dom": "19.2.3",
    "resend": "^6.9.2",
    "ws": "^8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.4",
    "@openzeppelin/contracts": "^5.4.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "ethers": "^6.16.0",
    "hardhat": "^3.1.7",
    "pm2": "^5.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
